{
  "name": "personal-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Role-based cross-project AI team orchestrated over Pi RPC",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "lint": "biome check src test",
    "format": "biome check --write src test",
    "typecheck": "tsc --noEmit",
    "check": "biome check src test && tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/**/*.test.ts",
    "demo:rpc": "node src/demo/rpc-smoke.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
