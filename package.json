{
  "name": "personal-agent",
  "version": "0.9.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "pa-extensions/*"
  ],
  "description": "Role-based cross-project AI team orchestrated over Pi RPC",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "lint": "biome check apps packages pa-extensions pi-extensions test scripts e2e",
    "format": "biome check --write apps packages pa-extensions pi-extensions test scripts e2e",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/web/tsconfig.json",
    "check:boundaries": "node scripts/check-module-boundaries.mjs",
    "check:css": "node scripts/check-css-classes.mjs",
    "check:sizes": "node scripts/check-file-sizes.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:boundaries && npm run check:css && npm run check:sizes",
    "build:cli": "node scripts/build-cli.mjs",
    "build:web": "node scripts/build-web.mjs",
    "build": "npm run build:cli && npm run build:web",
    "start:web": "npm run build:web && node apps/cli/src/main.ts",
    "start:team:sandbox": "npm run build:web && node scripts/start-team-sandbox.mjs",
    "test": "node scripts/run-tests.mjs",
    "e2e": "npm run build:web && npx playwright test -c e2e/playwright.config.ts --project=no-agent",
    "e2e:headed": "npm run build:web && npx playwright test -c e2e/playwright.config.ts --project=no-agent --headed",
    "e2e:browser:live": "npm run build:web && npx playwright test -c e2e/playwright.config.ts --project=live",
    "e2e:browser:live:headed": "npm run build:web && npx playwright test -c e2e/playwright.config.ts --project=live --headed",
    "e2e:live": "node e2e/run-live.ts",
    "demo:rpc": "node packages/server/src/demo/rpc-smoke.ts",
    "demo:team": "node packages/server/src/demo/team-smoke.ts",
    "demo:team:capabilities": "node packages/server/src/demo/team-capabilities-smoke.ts",
    "demo:space": "node packages/server/src/demo/space-smoke.ts",
    "check:startup": "node scripts/check-server-startup.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:opensource": "node scripts/check-open-source.mjs",
    "package:release": "node scripts/package-release.mjs",
    "demo:rsi": "node packages/server/src/demo/rsi-smoke.ts",
    "demo:trust": "node packages/server/src/demo/rsi-smoke.ts",
    "demo:pi-native": "node packages/server/src/demo/pi-native-smoke.ts",
    "demo:solo": "node packages/server/src/demo/solo-vs-business-smoke.ts",
    "demo:mention-verify": "node packages/server/src/demo/mention-verify-smoke.ts",
    "demo:board": "node packages/server/src/demo/board-smoke.ts",
    "demo:board:complex": "node packages/server/src/demo/board-complex-smoke.ts",
    "demo:review": "node packages/server/src/demo/publication-review-smoke.ts",
    "demo:observer": "node packages/server/src/demo/observer-smoke.ts",
    "demo:architect": "node packages/server/src/demo/role-design-smoke.ts --scenario architect",
    "demo:roles": "node packages/server/src/demo/role-design-smoke.ts --scenario builtin",
    "demo:decision": "node packages/server/src/demo/decision-smoke.ts",
    "demo:pstack": "node packages/server/src/demo/pstack-smoke.ts",
    "demo:pstack:selection": "node packages/server/src/demo/pstack-selection-smoke.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/node": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.4",
    "@typesafe-ai/sdk": "0.7.0",
    "hono": "^4.13.23",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "valibot": "^1.5.0",
    "zustand": "^5.1.0"
  }
}
