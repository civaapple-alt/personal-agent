{
  "name": "personal-agent",
  "version": "0.6.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Role-based cross-project AI team orchestrated over Pi RPC",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "lint": "biome check src test web/src scripts",
    "format": "biome check --write src test web/src scripts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "check": "biome check src test web/src scripts && npm run typecheck",
    "build:web": "node scripts/build-web.mjs",
    "build": "tsc -p tsconfig.build.json && npm run build:web",
    "start:web": "npm run build:web && node src/server/main.ts",
    "test": "node --test test/**/*.test.ts",
    "demo:rpc": "node src/demo/rpc-smoke.ts",
    "demo:team": "node src/demo/team-smoke.ts",
    "check:startup": "node scripts/check-server-startup.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:opensource": "node scripts/check-open-source.mjs",
    "package:release": "node scripts/package-release.mjs",
    "demo:rsi": "node src/demo/rsi-smoke.ts",
    "demo:inner": "node src/demo/inner-matter-smoke.ts",
    "demo:review": "node src/demo/publication-review-smoke.ts",
    "demo:observer": "node src/demo/observer-smoke.ts",
    "demo:architect": "node src/demo/role-design-smoke.ts --scenario architect",
    "demo:roles": "node src/demo/role-design-smoke.ts --scenario builtin",
    "demo:decision": "node src/demo/decision-smoke.ts",
    "demo:pstack": "node src/demo/pstack-smoke.ts",
    "demo:pstack:selection": "node src/demo/pstack-selection-smoke.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
