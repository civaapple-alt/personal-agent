{
	"$schema": "https://biomejs.dev/schemas/2.3.5/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "off",
				"useConst": "error",
				"useNodejsImportProtocol": "error"
			},
			"suspicious": {
				"noExplicitAny": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 3,
		"lineWidth": 120
	},
	"files": {
		"includes": [
			"apps/cli/src/**/*.ts",
			"apps/web/src/**/*.ts",
			"apps/web/src/**/*.tsx",
			"packages/**/*.ts",
			"pa-extensions/**/*.{ts,tsx}",
			"pi-extensions/**/*.{ts,js}",
			"test/**/*.ts",
			"scripts/**/*.mjs",
			"!**/node_modules/**/*",
			"!**/dist/**/*"
		]
	}
}
